file(READ ${LIBATRAC9_DIR}/unpack.c libatrac9Unpack)
set(libatrac9OldGuard "block->GradientEndUnit < 0 || block->GradientEndUnit >= 48")
set(libatrac9NewGuard "block->GradientEndUnit < 0 || block->GradientEndUnit > 31")
string(FIND "${libatrac9Unpack}" "${libatrac9OldGuard}" libatrac9GuardPosition)
if(libatrac9GuardPosition EQUAL -1)
    message(FATAL_ERROR "LibAtrac9 gradient guard has changed; review the local bounds fix")
endif()
string(REPLACE "${libatrac9OldGuard}" "${libatrac9NewGuard}" libatrac9Unpack "${libatrac9Unpack}")
file(MAKE_DIRECTORY ${LIBATRAC9_PATCHED_DIR})
file(WRITE ${LIBATRAC9_PATCHED_DIR}/unpack.c "${libatrac9Unpack}")

file(READ ${LIBATRAC9_DIR}/decinit.c libatrac9Decinit)
set(libatrac9OldConfigGuard "header != 0xFE || validationBit != 0")
set(libatrac9NewConfigGuard "header != 0xFE || validationBit != 0 || config->ChannelConfigIndex > 5")
string(FIND "${libatrac9Decinit}" "${libatrac9OldConfigGuard}" libatrac9ConfigGuardPosition)
if(libatrac9ConfigGuardPosition EQUAL -1)
    message(FATAL_ERROR "LibAtrac9 config data guard has changed; review the local bounds fix")
endif()
string(REPLACE "${libatrac9OldConfigGuard}" "${libatrac9NewConfigGuard}" libatrac9Decinit "${libatrac9Decinit}")
file(WRITE ${LIBATRAC9_PATCHED_DIR}/decinit.c "${libatrac9Decinit}")
